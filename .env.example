# =====================================================================
# 环境变量样例：cp .env.example .env 后按需填写（脚本/代码读进程环境，
# 不自动加载 .env；请在启动前 source .env 或用 dotenv 工具注入）。
# =====================================================================

# --- LLM-as-Judge（general 域兜底打分；官方 verify 脚本可用时不依赖）---
# OpenAI 兼容端点
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# 兜底：未配置 JUDGE_* 时回退到 OPENAI_*（若两者都空 -> general 域 infra）
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- IL 轨迹采集用的 policy（OpenAI 兼容；见 data/collect_il_demo.py）---
POLICY_BASE_URL=
POLICY_API_KEY=
POLICY_MODEL=

# --- 远程沙箱（--backend remote 时；典型：GPU 实例 + 外接 CPU 沙箱服务器）---
# scripts/prepare_data.sh 读取 SANDBOX_BACKEND（docker|remote|local）
SANDBOX_BACKEND=docker
SANDBOX_URL=http://127.0.0.1:8100
# 共享密钥：与沙箱服务器的 SANDBOX_TOKEN 一致（请求头 X-Sandbox-Token）
SANDBOX_TOKEN=
# 远程会话/长命令的 HTTP 传输超时（秒；长 verifier 会自动放大）
SANDBOX_HTTP_TIMEOUT=30.0

# --- Docker 沙箱资源默认值（任务级 spec.cpus/memory_mb 优先）---
SANDBOX_DOCKER_MEMORY=2g
SANDBOX_DOCKER_CPUS=2.0
SANDBOX_DOCKER_PIDS_LIMIT=256
# 容器自毁 TTL（秒），+verifier_timeout_sec 余量
SANDBOX_TTL_SEC=7200
# 镜像自动 pull 的墙钟超时（秒）
SANDBOX_DOCKER_PULL_TIMEOUT=1800

# --- HuggingFace/ModelScope 下载（国内建议镜像）---
HF_ENDPOINT=https://hf-mirror.com
# 数据/映射表下载通道：modelscope（默认，国内快）| hf
MS_CHANNEL=modelscope

# --- Blackwell(sm120) GPU 兼容 ---
# flashinfer 0.6.12 wheel 未编 sm120 cubin；vLLM sampler import flashinfer 会崩。
# run_grpo.sh/run_sft.sh 已默认注入 0；直跑 python 训练时需自行 export。
VLLM_USE_FLASHINFER_SAMPLER=0
